model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - Sales_Forecasting"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table model_series_fh_metrics
ref table model_series_metrics
ref table eval_table
ref table model_fh_metrics
ref table compiled_values
ref table model_metrics
ref table key_table
ref table monthly_agg
ref table model_training_metrics

